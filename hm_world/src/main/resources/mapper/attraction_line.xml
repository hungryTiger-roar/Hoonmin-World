<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.hm.repo.AttractionLineRepo">

	<insert id="insert" parameterType="com.ssafy.hm.dto.AttractionLine" useGeneratedKeys="true" keyProperty="lineId">
		insert into attraction_line (att_id, user_id)
		values (#{attId}, #{userId});
	</insert>

	<select id="selectByAttraction" parameterType="int" resultType="com.ssafy.hm.dto.AttractionLine">
		select line_id as lineId, att_id as attId, user_id as userId
		from attraction_line
		where att_id = #{attId};
	</select>

	<delete id="delete" parameterType="int">
		delete from attraction_line where line_id = #{lineId};
	</delete>

</mapper>
