<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.hm.repo.OrdersRepo">

	<insert id="insert" parameterType="com.ssafy.hm.dto.Orders" useGeneratedKeys="true" keyProperty="orderId">
		insert into orders (user_id)
		values (#{userId});
	</insert>

	<select id="selectByUser" parameterType="string" resultType="com.ssafy.hm.dto.Orders">
		select order_id as orderId, user_id as userId
		from orders
		where user_id = #{userId};
	</select>

</mapper>
