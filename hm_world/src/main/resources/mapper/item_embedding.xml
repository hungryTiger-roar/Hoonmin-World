<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.hm.repo.ItemEmbeddingRepo">

  <resultMap id="ItemEmbeddingMap" type="com.ssafy.hm.dto.ItemEmbedding">
    <id property="itemId" column="item_id"/>
    <result property="imageCaption" column="image_caption"/>
    <result property="embeddingJson" column="embedding_json"/>
    <result property="updatedAt" column="updated_at"/>
  </resultMap>

  <select id="findByItemId" resultMap="ItemEmbeddingMap">
    SELECT * FROM item_embedding WHERE item_id = #{itemId}
  </select>

  <select id="findAll" resultMap="ItemEmbeddingMap">
    SELECT * FROM item_embedding
  </select>

  <insert id="upsert">
    INSERT INTO item_embedding (item_id, image_caption, embedding_json)
    VALUES (#{itemId}, #{imageCaption}, #{embeddingJson})
    ON DUPLICATE KEY UPDATE
      image_caption = VALUES(image_caption),
      embedding_json = VALUES(embedding_json)
  </insert>

</mapper>
