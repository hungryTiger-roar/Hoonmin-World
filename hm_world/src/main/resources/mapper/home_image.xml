<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.hm.repo.HomeImageRepo">

	<insert id="insert" parameterType="com.ssafy.hm.dto.HomeImage"
	        useGeneratedKeys="true" keyProperty="homeId">
		insert into home_image (home_image)
		values (#{homeImage});
	</insert>

	<select id="selectAll" resultType="com.ssafy.hm.dto.HomeImage">
		select home_id as homeId,
		       home_image as homeImage
		from home_image;
	</select>

	<delete id="delete" parameterType="int">
		delete from home_image
		where home_id = #{homeId};
	</delete>

</mapper>
