<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.hm.repo.FriendLineRepo">

	<insert id="insert" parameterType="com.ssafy.hm.dto.FriendLine" useGeneratedKeys="true" keyProperty="friendLineId">
		insert into friend_line (line_id, friend_id)
		values (#{lineId}, #{friendId});
	</insert>

	<select id="selectByLine" parameterType="int" resultType="com.ssafy.hm.dto.FriendLine">
		select friend_line_id as friendLineId, line_id as lineId, friend_id as friendId
		from friend_line
		where line_id = #{lineId};
	</select>

	<delete id="delete" parameterType="int">
		delete from friend_line where friend_line_id = #{friendLineId};
	</delete>

</mapper>
